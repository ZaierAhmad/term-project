"scripts": {
  "lint:html": "htmlhint src/",
  "lint:css": "stylelint styles/**/*.css",
  "build": "parcel build src/*.html --dist-dir build",
  "build:dev": "parcel build src/*.html --dist-dir build --public-url /",
  "build:staging": "parcel build src/*.html --dist-dir build --public-url /staging/",
  "build:prod": "parcel build src/*.html --dist-dir build --public-url /"
},
